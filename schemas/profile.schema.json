{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "fullName": { "type": "string" },
    "professionalTitle": { "type": "string" },
    "heroHeading": { "type": "string" },
    "heroAccent": { "type": "string" },
    "heroIntroduction": { "type": "string" },
    "aboutText": { "type": "array", "items": { "type": "string" } },
    "location": { "type": "string" },
    "availabilityStatus": { "type": "string" },
    "email": { "type": "string" },
    "githubUrl": { "type": "string" },
    "linkedinUrl": { "type": "string" },
    "cvPath": { "type": "string" },
    "mainCtaLabels": { "type": "object" }
  },
  "required": ["fullName", "professionalTitle", "email"]
}
