{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "slug": { "type": "string" },
      "title": { "type": "string" },
      "issuer": { "type": "string" },
      "issueDate": { "type": "string" },
      "credentialId": { "type": "string" },
      "certificateFile": { "type": "string" },
      "featured": { "type": "boolean" },
      "displayOrder": { "type": "number" },
      "icon": { "type": "string" }
    },
    "required": ["id", "title", "certificateFile"]
  }
}
